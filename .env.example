# Copy to .env and fill in. .env is git-ignored — never commit real secrets.
# In CI/CD these are written from GitHub environment secrets (see DEPLOYMENT.md).

# LLM provider keys (knowledge generation / benchmarking). XAI_API_KEY also powers
# the web_search feature (Grok web_search Agent Tool) — without it web search is disabled.
XAI_API_KEY=
AZURE_OPENAI_API_KEY_gpt_41_mini=
AZURE_OPENAI_API_KEY_gpt_53_chat=

# Tavily was the previous web-search provider; replaced by Grok (XAI_API_KEY). Kept
# here (unused) in case we revisit a dedicated search API later.
TAVILY_API_KEY=

# Web app login (Gradio auth layer). Required when serving beyond localhost.
KAYA_WEB_USER=
KAYA_WEB_PASS=

# Cloudflare Tunnel token (remotely-managed tunnel). From the Cloudflare
# Zero Trust dashboard → Networks → Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# WhatsApp bridge (WAHA). Only needed when whatsapp.enabled with a real number —
# the mock flow (KAYA_WHATSAPP_MOCK=1) needs none of these.
KAYA_WAHA_API_KEY=
KAYA_WHATSAPP_WEBHOOK_TOKEN=

# ── GPU assignment ────────────────────────────────────────────────────────────
# This box has two RTX 3090s and no NVLink: two independent 24GB devices, never a
# 48GB pool. The live model (gemma-4-12b Q6_K + a 32K cache) needs ~13GB, so it
# fits ONE card and the other stays free for dev, training and other projects.
#
# Address the cards by UUID, NOT by index — nvidia-smi index order can change
# across reboots (gpu-power-limit.service uses UUIDs for the same reason).
# List them with:  nvidia-smi --query-gpu=index,uuid,pci.bus_id --format=csv
#
#   KAYA_GPU_PROD → the compute-only card (no display, higher power cap).
#   KAYA_GPU_DEV  → the card driving the desktop; everything that is not prod.
#
# Leave both blank to fall back to `all` (every container sees both cards) —
# needed only when serving a model too large for one card, alongside
# KAYA_PROD_SM=layer.
KAYA_GPU_PROD=
KAYA_GPU_DEV=

# Which GGUF prod serves, and its context window. KAYA_PROD_CTX must exceed
# rag.max_context_tokens with headroom for the system prompt and history.
KAYA_PROD_GGUF=
KAYA_PROD_CTX=
# -sm none keeps the model on one card; set to `layer` to split across both.
KAYA_PROD_SM=
