# Copied to the Pi as ~/kaya-gateway/deploy/pi/.env by scripts/deploy_pi.sh (never committed).
# Profiles to start: add waha once its session has moved here, tunnel at cutover.
COMPOSE_PROFILES=
PI_LAN_IP=192.168.1.238
KAYA_PC_URL=http://192.168.1.149:7860
KAYA_RELAY_TOKEN=
KAYA_WAHA_API_KEY=
KAYA_WHATSAPP_WEBHOOK_TOKEN=
KAYA_WEB_USER=
KAYA_WEB_PASS=
CLOUDFLARE_TUNNEL_TOKEN=
# Wake-on-LAN target (pc-wake.sh)
PC_MAC=b4:2e:99:92:4f:be
PC_BROADCAST=192.168.1.255
# /homelaboff and /homelabon: the owner's number(s), comma-separated, digits only
HOMELAB_OWNER_NUMBERS=
# /help (src/gateway/help_tap.py): the owner's number(s), comma-separated, digits only.
# Empty = off; falls back to IDEA_OWNER_NUMBERS. The link line comes from GATEWAY_HELP_URL.
HELP_OWNER_NUMBERS=
# The labwatch Help page URL appended to the /help reply; empty = no link.
GATEWAY_HELP_URL=
# Birthday messages (src/gateway/birthdays.py): the general group's JID. Empty = off.
GATEWAY_BIRTHDAY_CHAT=
